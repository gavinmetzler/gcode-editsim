{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GCode EditSim",
  "identifier": "com.ncsoftbyai.gcodeeditsim",
  "version": "0.5.0",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GCode EditSim",
        "width": 1200,
        "height": 800,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Edit CNC G-code programs and see their toolpath in 3D",
    "longDescription": "A G-code editor beside a synced 3D backplot of 3-axis milling programs (Fanuc and Osai 10 Series), with diagnostics, statistics and a time estimate. A visualization aid, not a safety check.",
    "license": "AGPL-3.0-only",
    "homepage": "https://github.com/gavinmetzler/gcode-editsim",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "section": "devel",
        "desktopTemplate": "../../packaging/linux/desktop.hbs",
        "files": {
          "/usr/share/mime/packages/com.ncsoftbyai.gcodeeditsim.xml": "../../packaging/flatpak/com.ncsoftbyai.gcodeeditsim.xml",
          "/usr/share/icons/hicolor/scalable/apps/com.ncsoftbyai.gcodeeditsim.svg": "../../packaging/icons/com.ncsoftbyai.gcodeeditsim.svg",
          "/usr/share/licenses/gcode-editsim/LICENSE": "../../LICENSE"
        }
      },
      "rpm": {
        "desktopTemplate": "../../packaging/linux/desktop.hbs",
        "files": {
          "/usr/share/mime/packages/com.ncsoftbyai.gcodeeditsim.xml": "../../packaging/flatpak/com.ncsoftbyai.gcodeeditsim.xml",
          "/usr/share/icons/hicolor/scalable/apps/com.ncsoftbyai.gcodeeditsim.svg": "../../packaging/icons/com.ncsoftbyai.gcodeeditsim.svg",
          "/usr/share/licenses/gcode-editsim/LICENSE": "../../LICENSE"
        }
      }
    }
  }
}
