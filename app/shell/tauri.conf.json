{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GCode EditSim",
  "identifier": "com.ncsoftbyai.gcodeeditsim",
  "version": "0.1.0",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [
      {
        "title": "GCode EditSim",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
